<UserControl x:Class="Aegis.LocalAgent.VisualStudio.ToolWindows.AegisToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101720">
  <UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E6EEF6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="#172536" />
      <Setter Property="Foreground" Value="#E6EEF6" />
      <Setter Property="BorderBrush" Value="#29D3FF" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1118" />
      <Setter Property="Foreground" Value="#E6EEF6" />
      <Setter Property="BorderBrush" Value="#26394B" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="#29D3FF" />
      <Setter Property="BorderBrush" Value="#26394B" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="6" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="180" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Auralith OS" FontSize="18" FontWeight="Bold" Foreground="#29D3FF" />
        <TextBlock x:Name="StatusText" Text="Starting..." Foreground="#FFB86C" Margin="0,2,0,4" FontWeight="Bold" />
        <TextBlock x:Name="ModelStatusText" Text="Model status: not checked" Foreground="#94A3B8" Margin="0,0,0,8" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Model" Foreground="#94A3B8" />
        <ComboBox x:Name="ModelSelector" IsEditable="True" Text="qwen3-coder:30b" />
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" Background="#101720" BorderBrush="#26394B">
      <TabItem Header="Solution">
        <ScrollViewer>
          <StackPanel Margin="4">
            <GroupBox Header="Active Solution">
              <TextBox x:Name="SolutionInfoBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Active Project / Selection">
              <TextBox x:Name="ProjectInfoBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Runtime Authority">
              <TextBox x:Name="RuntimeStatusBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Health / Build Status">
              <TextBox x:Name="BuildStatusBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Settings Summary">
              <TextBox x:Name="SettingsSummaryBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Intelligence">
        <ScrollViewer>
          <StackPanel Margin="4">
            <GroupBox Header="Scan Status">
              <TextBox x:Name="ScanStatusBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Architecture Map">
              <TextBox x:Name="ArchitectureBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="170" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Roadmap">
              <TextBox x:Name="RoadmapBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Indexed Symbols">
              <TextBox x:Name="SymbolsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Dependency Map">
              <TextBox x:Name="DependencyMapBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Chat">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox x:Name="ChatHistoryBox" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
          <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Content="Send" DockPanel.Dock="Right" Click="SendChat_Click" />
            <TextBox x:Name="ChatInputBox" MinHeight="30" AcceptsReturn="False" />
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Agent">
        <ScrollViewer>
          <StackPanel Margin="4">
            <GroupBox Header="Agent Session">
              <StackPanel>
                <TextBlock x:Name="CurrentModeText" Text="Mode: Idle" Foreground="#29D3FF" FontWeight="Bold" />
                <TextBlock x:Name="ApprovalStatusText" Text="Approval: No pending proposal." Foreground="#94A3B8" />
                <TextBlock x:Name="RepairAttemptText" Text="Repair Attempts: 0/3" Foreground="#FF5A66" />
                <TextBlock Text="Current Plan" FontWeight="Bold" Margin="0,8,0,4" />
                <TextBox x:Name="PlanBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="Affected Files" FontWeight="Bold" Margin="0,8,0,4" />
                <TextBox x:Name="AffectedFilesBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Native Actions">
              <WrapPanel>
                <Button Content="Health Check" Click="HealthCheck_Click" />
                <Button Content="Explain File" Click="ExplainFile_Click" />
                <Button Content="Review Selection" Click="ReviewSelection_Click" />
                <Button Content="Refactor Selection" Click="RefactorSelection_Click" />
                <Button Content="Review Startup Project" Click="ReviewStartupProject_Click" />
                <Button Content="Fix Build Errors" Click="FixBuildErrors_Click" />
                <Button Content="Fix Selected Error" Click="FixSelectedError_Click" />
                <Button Content="Explain Build Failure" Click="ExplainBuildFailure_Click" />
                <Button Content="Generate Roadmap" Click="GenerateRoadmap_Click" />
                <Button Content="Continue Roadmap" Click="ContinueRoadmap_Click" />
                <Button Content="Continue Solution" Click="ContinueSolution_Click" />
                <Button Content="Generate Tests" Click="GenerateTests_Click" />
                <Button Content="Rescan Intelligence" Click="RescanIntelligence_Click" />
              </WrapPanel>
            </GroupBox>
            <GroupBox Header="Validation">
              <WrapPanel>
                <Button Content="Build Solution" Click="BuildSolution_Click" />
                <Button Content="Build Startup Project" Click="BuildStartupProject_Click" />
                <Button Content="Build Selected Project" Click="BuildSelectedProject_Click" />
                <Button Content="Clean Solution" Click="CleanSolution_Click" />
                <Button Content="Rebuild Solution" Click="RebuildSolution_Click" />
                <Button Content="Allow More Repair" Click="AllowMoreRepair_Click" />
              </WrapPanel>
            </GroupBox>

            <GroupBox Header="Agent Request">
              <StackPanel>
                <TextBox x:Name="AgentRequestBox" MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Propose Changes" Click="ProposeChanges_Click" />
                  <Button Content="Apply Approved" Click="ApplyApproved_Click" />
                  <Button Content="Rollback Last" Click="RollbackLast_Click" />
                </WrapPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Errors">
        <ScrollViewer>
          <StackPanel Margin="4">
            <GroupBox Header="Selected Error">
              <TextBox x:Name="SelectedErrorBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
            <GroupBox Header="Validation Output">
              <TextBox x:Name="ValidationBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240" VerticalScrollBarVisibility="Auto" />
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Proposal">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="ProposalSummaryText" Grid.Row="0" Margin="4" Foreground="#29D3FF" />
          <GroupBox Grid.Row="1" Header="Proposal Details">
            <TextBox x:Name="ProposalBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
          </GroupBox>
          <GroupBox Grid.Row="2" Header="Diff Preview">
            <TextBox x:Name="DiffBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
          </GroupBox>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="All edits require approval. Backups are written to .aegis/backups before applying." Foreground="#94A3B8" Margin="0,8,0,0" />
  </Grid>
</UserControl>
