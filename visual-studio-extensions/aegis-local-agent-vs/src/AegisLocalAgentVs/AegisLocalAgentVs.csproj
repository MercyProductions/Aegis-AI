<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Aegis.LocalAgent.VisualStudio</RootNamespace>
    <AssemblyName>AegisLocalAgentVs</AssemblyName>
    <TargetName>AegisLocalAgentVs</TargetName>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeAssemblyFromOutputFolderInVSIXContainer>true</IncludeAssemblyFromOutputFolderInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">17.0</VisualStudioVersion>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(UserProfile)\.nuget\packages\</NuGetPackageRoot>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\</IntermediateOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <CreatePkgDefAssemblyToProcess>$(OutputPath)$(AssemblyName).dll</CreatePkgDefAssemblyToProcess>
    <TargetVsixContainerName>AegisLocalAgentVs.vsix</TargetVsixContainerName>
    <TargetVsixContainer>$(OutputPath)$(TargetVsixContainerName)</TargetVsixContainer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="AegisLocalAgentPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <EmbeddedResource Update="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <Content Include="..\..\README.md" Link="README.md" IncludeInVSIX="true" />
    <Content Include="..\..\INSTALL.md" Link="INSTALL.md" IncludeInVSIX="true" />
    <Content Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" IncludeInVSIX="true" />
    <Content Include="..\..\RELEASE_NOTES.md" Link="RELEASE_NOTES.md" IncludeInVSIX="true" />
    <Content Include="..\..\TROUBLESHOOTING.md" Link="TROUBLESHOOTING.md" IncludeInVSIX="true" />
    <Content Include="..\..\DOGFOODING_NOTES.md" Link="DOGFOODING_NOTES.md" IncludeInVSIX="true" />
    <Content Include="..\..\LICENSE.txt" Link="LICENSE.txt" IncludeInVSIX="true" />
    <Content Include="Resources\AegisIcon.png" IncludeInVSIX="true" />
  </ItemGroup>

  <Import Project="$(NuGetPackageRoot)microsoft.vssdk.buildtools\17.14.2142\tools\vssdk\Microsoft.VsSDK.targets"
          Condition="Exists('$(NuGetPackageRoot)microsoft.vssdk.buildtools\17.14.2142\tools\vssdk\Microsoft.VsSDK.targets')" />
</Project>
