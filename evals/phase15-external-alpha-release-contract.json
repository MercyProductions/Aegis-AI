  "hard_blockers": [
    {
      "id": "release_artifact_matrix",
      "description": "Core, Website, Desktop, VS Code, and Visual Studio artifacts must be listed with version, checksum, size, and signing or unsigned-build disclosure."
    },
    {
      "id": "ecosystem_validation_evidence",
      "description": "A release evidence folder must contain validation-matrix.json and validation-summary.md from scripts/validate-ecosystem.ps1."
    },
    {
      "id": "alpha_scenario_suite_evidence",
      "description": "The Phase 14 scenario suite must be run end-to-end and attached to the alpha report."
    },
    {
      "id": "cross_client_parity_evidence",
      "description": "Website, Desktop, VS Code, and Visual Studio must demonstrate the same safe workflow with recovery visibility."
    },
    {
      "id": "rollback_update_dry_run",
      "description": "Release packaging and update planner dry runs must produce rollback evidence."
    },
    {
      "id": "known_limitations_release_notes",
      "description": "Known limitations must be explicit in the alpha report and release notes."
    },
    {
      "id": "signing_checksum_disclosure",
      "description": "Checksums are required and unsigned local builds must be clearly disclosed."
    }
